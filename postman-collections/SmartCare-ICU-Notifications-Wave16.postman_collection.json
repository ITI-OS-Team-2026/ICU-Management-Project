{
  "info": {
    "name": "SmartCare ICU - Notifications (Wave 16)",
    "description": "Notifications endpoints (Wave 16). Run '0. Setup' first — it creates patient + bed + ACTIVE admission fixtures and stores IDs as collection variables. Auth is handled via Postman's cookie jar (login requests set the HttpOnly JWT cookie automatically).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "nurse_email",
      "value": "nurse@smartcare.icu"
    },
    {
      "key": "resident_email",
      "value": "resident@smartcare.icu"
    },
    {
      "key": "specialist_email",
      "value": "specialist@smartcare.icu"
    },
    {
      "key": "shared_password",
      "value": "SuperSecurePassword2026!"
    },
    {
      "key": "patient_id",
      "value": ""
    },
    {
      "key": "bed_id",
      "value": ""
    },
    {
      "key": "doctor_id",
      "value": ""
    },
    {
      "key": "admission_id",
      "value": ""
    },
    {
      "key": "notification_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "Login Specialist (Retrieve Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Logs in as ICU Specialist. Cookie jar picks up the JWT automatically. Also captures the doctor_id for use in admission creation.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{specialist_email}}\",\n  \"password\": \"{{shared_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login Specialist - Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('doctor_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Insert Dummy Patient into [patients] table",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/patients",
              "host": ["{{base_url}}"],
              "path": ["patients"]
            },
            "description": "Creates a test patient. MRN uses $timestamp to guarantee uniqueness across runs.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mrn\": \"PM-NOTIF-{{$timestamp}}\",\n  \"name\": \"Notification Patient\",\n  \"age\": 45\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Create Patient - Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('patient_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Admin (Retrieve Token for Bed Creation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Bed creation requires SYSTEM_ADMIN. Logs in as admin so the next request is authorised.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@smartcare.icu\",\n  \"password\": \"{{shared_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login Admin - Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Insert Dummy Bed into [beds] table",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/beds",
              "host": ["{{base_url}}"],
              "path": ["admin", "beds"]
            },
            "description": "Creates a unique bed using $timestamp. bed_id is stored for use in admission creation.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bed_number\": \"NOTIF-{{$timestamp}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Create Bed - Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('bed_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Specialist (Retrieve Token for Admission)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Admission creation requires ICU_SPECIALIST or MEDICAL_RESIDENT. Re-logins as specialist whose id was captured as doctor_id above.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{specialist_email}}\",\n  \"password\": \"{{shared_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login Specialist (admission) - Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Insert Dummy Admission into [admissions] table",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admissions",
              "host": ["{{base_url}}"],
              "path": ["admissions"]
            },
            "description": "Creates the main ACTIVE admission used throughout all notification tests. Stores admission_id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": \"{{patient_id}}\",\n  \"bed_id\": \"{{bed_id}}\",\n  \"doctor_id\": \"{{doctor_id}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Create Active Admission - Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('admission_id', pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. POST /admissions/:id/summon",
      "item": [
        {
          "name": "Login Nurse (Retrieve Token for Summon)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Switches the cookie jar to an ICU_NURSE session. Only ICU_NURSE is allowed to summon a doctor.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{nurse_email}}\",\n  \"password\": \"{{shared_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login Nurse - Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST - 200 Summon Doctor (with reason)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admissions/{{admission_id}}/summon",
              "host": ["{{base_url}}"],
              "path": ["admissions", "{{admission_id}}", "summon"]
            },
            "description": "Happy path: nurse summons the admission's assigned doctor with a reason. Expects 200 and a notification object. Saves notification_id for PATCH /read tests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Patient condition deteriorating — immediate attention required\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Summon Doctor - Status is 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Response status is success', () => pm.expect(res.status).to.eql('success'));",
                  "pm.test('Returns notification object', () => pm.expect(res.data.notification).to.have.property('id'));",
                  "pm.test('Notification type is SUMMON', () => pm.expect(res.data.notification.type).to.eql('SUMMON'));",
                  "pm.test('Notification status defaults to UNREAD', () => pm.expect(res.data.notification.status).to.eql('UNREAD'));",
                  "pm.collectionVariables.set('notification_id', res.data.notification.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST - 200 Summon Doctor (without reason)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admissions/{{admission_id}}/summon",
              "host": ["{{base_url}}"],
              "path": ["admissions", "{{admission_id}}", "summon"]
            },
            "description": "Summon without an optional reason field — service should still succeed and omit the reason from the message.",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Summon Without Reason - Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns notification', () => pm.expect(pm.response.json().data.notification).to.have.property('id'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST - 404 Unknown Admission",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admissions/00000000-0000-0000-0000-000000000000/summon",
              "host": ["{{base_url}}"],
              "path": ["admissions", "00000000-0000-0000-0000-000000000000", "summon"]
            },
            "description": "Service returns 404 when the admission UUID does not exist in the DB.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Test\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Summon (unknown admission) - Status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Specialist (for 403 check)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Switches session to ICU_SPECIALIST to verify that only ICU_NURSE can summon.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{specialist_email}}\",\n  \"password\": \"{{shared_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login Specialist (403 check) - Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST - 403 Specialist cannot summon",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admissions/{{admission_id}}/summon",
              "host": ["{{base_url}}"],
              "path": ["admissions", "{{admission_id}}", "summon"]
            },
            "description": "restrictTo(['ICU_NURSE']) blocks ICU_SPECIALIST at the middleware layer.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"I am a doctor, I should not be summoning myself\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Summon (specialist) - Status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST - 401 No Auth Cookie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admissions/{{admission_id}}/summon",
              "host": ["{{base_url}}"],
              "path": ["admissions", "{{admission_id}}", "summon"]
            },
            "description": "Sends the summon request without any session. verifyToken middleware must respond 401.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Test\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Clear the auth cookie so the request is unauthenticated",
                  "pm.cookies.clear('localhost');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Summon (no cookie) - Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. GET /notifications",
      "item": [
        {
          "name": "Login Specialist (Retrieve Token for Notifications)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Re-establishes the specialist session. The specialist is the doctor targeted by the summon, so their inbox should contain the notification created above.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{specialist_email}}\",\n  \"password\": \"{{shared_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login Specialist (GET setup) - Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - 200 List All Notifications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/notifications",
              "host": ["{{base_url}}"],
              "path": ["notifications"]
            },
            "description": "Expects 200 and a data.notifications array scoped to the authenticated user."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('GET Notifications - Status is 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Response status is success', () => pm.expect(res.status).to.eql('success'));",
                  "pm.test('data.notifications is an array', () => pm.expect(res.data.notifications).to.be.an('array'));",
                  "pm.test('Contains at least one notification (from summon)', () => pm.expect(res.data.notifications.length).to.be.at.least(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - 200 Filter UNREAD Notifications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/notifications?status=UNREAD",
              "host": ["{{base_url}}"],
              "path": ["notifications"],
              "query": [
                {
                  "key": "status",
                  "value": "UNREAD"
                }
              ]
            },
            "description": "Passing ?status=UNREAD should return only unread notifications for this user."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('GET UNREAD Notifications - Status is 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('data.notifications is an array', () => pm.expect(res.data.notifications).to.be.an('array'));",
                  "if (res.data.notifications.length > 0) {",
                  "  pm.test('Every returned notification is UNREAD', () => {",
                  "    res.data.notifications.forEach(n => pm.expect(n.status).to.eql('UNREAD'));",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout (to clear session)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            },
            "description": "Clears the HttpOnly cookie so the next request is truly unauthenticated."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Logout - Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - 401 No Auth Cookie",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/notifications",
              "host": ["{{base_url}}"],
              "path": ["notifications"]
            },
            "description": "Sends the request without any cookie. verifyToken middleware must respond 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('GET Notifications (no cookie) - Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. PATCH /notifications/:id/read",
      "item": [
        {
          "name": "Login Specialist (Retrieve Token for Mark-as-Read)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Re-establishes the specialist session. The notification belongs to this user so markAsRead must succeed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{specialist_email}}\",\n  \"password\": \"{{shared_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login Specialist (PATCH setup) - Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH - 200 Mark Notification as Read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{base_url}}/notifications/{{notification_id}}/read",
              "host": ["{{base_url}}"],
              "path": ["notifications", "{{notification_id}}", "read"]
            },
            "description": "Happy path: marks the notification created in section 1 as READ. Expects 200 with the updated record returned."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Mark as Read - Status is 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Response status is success', () => pm.expect(res.status).to.eql('success'));",
                  "pm.test('Notification status is now READ', () => pm.expect(res.data.notification.status).to.eql('READ'));",
                  "pm.test('ID is unchanged', () => pm.expect(res.data.notification.id).to.eql(pm.collectionVariables.get('notification_id')));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - 200 Verify UNREAD Count Decreased",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/notifications?status=UNREAD",
              "host": ["{{base_url}}"],
              "path": ["notifications"],
              "query": [
                {
                  "key": "status",
                  "value": "UNREAD"
                }
              ]
            },
            "description": "After marking as READ, the notification must no longer appear in the UNREAD filter."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('GET UNREAD after mark-as-read - Status is 200', () => pm.response.to.have.status(200));",
                  "const unread = pm.response.json().data.notifications;",
                  "const notifId = pm.collectionVariables.get('notification_id');",
                  "pm.test('Marked notification is absent from UNREAD list', () => {",
                  "  const found = unread.find(n => n.id === notifId);",
                  "  pm.expect(found).to.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH - 404 Unknown Notification ID",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{base_url}}/notifications/00000000-0000-0000-0000-000000000000/read",
              "host": ["{{base_url}}"],
              "path": ["notifications", "00000000-0000-0000-0000-000000000000", "read"]
            },
            "description": "Service throws when the notification UUID does not exist or does not belong to the current user — controller maps this to 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Mark as Read (unknown id) - Status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Nurse (for ownership check)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Switches session to ICU_NURSE who does NOT own the specialist's notification.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{nurse_email}}\",\n  \"password\": \"{{shared_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login Nurse (ownership check) - Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH - 404 Cannot Read Another User's Notification",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{base_url}}/notifications/{{notification_id}}/read",
              "host": ["{{base_url}}"],
              "path": ["notifications", "{{notification_id}}", "read"]
            },
            "description": "The service checks notification.userId === req.user.id. A nurse trying to mark the specialist's notification must get 404 (not a 403, to avoid leaking resource existence)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Mark as Read (wrong user) - Status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
