title Clinical Information System Data Model

// ===== AUTHENTICATION & SECURITY =====
users [icon: user, color: blue] {
  id uuid pk
  first_name string
  last_name string
  email string
  password_hash string
  role enum
  status string
  auth_provider string
  phone string
  profile_image string
  last_login timestamp
  failed_login_attempts integer
  locked_until timestamp
}

login_attempts [icon: log-in, color: blue] {
  id uuid pk
  user_id uuid fk
  email string
  ip_address string
  user_agent string
  success boolean
  failure_reason string
  attempted_at timestamp
}

refresh_tokens [icon: key, color: blue] {
  id uuid pk
  user_id uuid fk
  token string
  expires_at timestamp
  is_revoked boolean
}

audit_logs [icon: shield, color: blue] {
  id uuid pk
  user_id uuid fk
  action enum // LOGIN, LOGOUT, CREATE, UPDATE, ARCHIVE, VIEW, ACCOUNT_LOCKED, GENERATE_SUMMARY, QUERY_RAG
  target_table string
  target_id uuid
  old_values jsonb
  new_values jsonb
  ip_address string
  user_agent string
  created_at timestamp
}

password_reset_requests [icon: key, color: blue] {
  id uuid pk
  requester_id uuid fk
  message text
  status enum // PENDING, RESOLVED
  admin_reply text
  resolved_by_id uuid fk
  resolved_at timestamp
  seen_by_user boolean
  created_at timestamp
}

// ===== CORE CLINICAL =====
patients [icon: heart, color: red] {
  id uuid pk
  mrn string
  national_id string
  name string
  age integer
  gender string
  residence text
  occupation text
  marital_status enum
  handedness enum
  children_count integer
  youngest_child_age string
  is_archived boolean
  archived_at timestamp
}

medical_histories [icon: clipboard, color: red] {
  id uuid pk
  patient_id uuid fk // unique — 1:1 with patients
  diabetes_dm boolean
  hypertension_htn boolean
  past_similar_conditions text
  past_diseases jsonb
  previous_operations boolean
  operations_details text
  has_allergies boolean
  traveled_abroad boolean
  consanguinity boolean
  family_similar_conditions text
  inherited_diseases jsonb
  free_text text
  custom_fields jsonb
  special_habits text
  blood_transfusion boolean
  menstrual_history jsonb
  obstetric_history jsonb
}

allergies [icon: alert-circle, color: red] {
  id uuid pk
  patient_id uuid fk
  allergen string
  severity string
  is_archived boolean
  archived_at timestamp
}

beds [icon: home, color: red] {
  id uuid pk
  bed_number string
  status string
}

admissions [icon: clipboard, color: red] {
  id uuid pk
  patient_id uuid fk
  bed_id uuid fk
  doctor_id uuid fk
  transfer_reason text // formerly admission_reason
  place_of_transfer text
  transfer_doctor_name text
  chief_complaint text
  complaint_analysis text
  symptoms_related_system text
  symptoms_other_systems text
  previous_investigations jsonb
  previous_treatments text
  provisional_diagnosis text
  status string
  admitted_at timestamp
  discharged_at timestamp
  is_archived boolean
  archived_at timestamp
}

admission_nurses [icon: users, color: red] {
  id uuid pk
  admission_id uuid fk
  nurse_id uuid fk
  assigned_at timestamp
  unassigned_at timestamp      // When the nurse stops caring for this patient
  is_archived boolean          // Soft delete
  archived_at timestamp        // When archived
}

diagnoses [icon: file-plus, color: red] {
  id uuid pk
  admission_id uuid fk
  condition_name text
  type enum // PRIMARY, SECONDARY, COMORBIDITY, COMPLICATION
  status enum // SUSPECTED, CONFIRMED, RULED_OUT, RESOLVED
  clinical_notes text
  diagnosed_by uuid fk
  original_diagnosed_by uuid fk
  diagnosed_at timestamp
  ruled_out_reason text
  resolved_at timestamp
  resolution_reason text
  status_changed_by uuid fk
  is_archived boolean
  archived_at timestamp
}

diagnosis_acknowledgements [icon: check, color: red] {
  id uuid pk
  diagnosis_id uuid fk
  nurse_id uuid fk
  acknowledged_at timestamp
  created_at timestamp
}

diagnosis_concerns [icon: alert-circle, color: red] {
  id uuid pk
  diagnosis_id uuid fk
  raised_by uuid fk
  note text
  status enum // OPEN, ADDRESSED, DISMISSED
  response_note text
  responded_by uuid fk
  responded_at timestamp
  created_at timestamp
  updated_at timestamp
}

// ===== CLINICAL RECORDING =====
vital_signs [icon: activity, color: green] {
  id uuid pk
  admission_id uuid fk
  recorded_by uuid fk
  temperature decimal // (35 - 45)
  pulse integer
  systolic_bp integer
  diastolic_bp integer
  respiratory_rate integer // (breath rate)
  spo2 integer
  is_override boolean
  override_reason text
  recorded_at timestamp
  is_archived boolean
  archived_at timestamp
}

medications [icon: package, color: green] {
  id uuid pk
  admission_id uuid fk
  prescribed_by uuid fk
  original_prescriber_id uuid fk
  drug_name string
  dosage string
  frequency enum // OD, BD, TDS, QDS, Q4H, Q6H, Q8H, Q12H, PRN, STAT, CONTINUOUS, OTHER
  frequency_text string
  route enum // IV, PO, IM, SC, INH, TOPICAL, PR, NG
  instructions text
  start_date timestamp
  end_date timestamp
  prescribed_at timestamp
  is_active boolean
  allergy_acknowledged boolean
  discontinued_by uuid fk
  discontinued_at timestamp
  discontinue_reason text
  is_archived boolean
  archived_at timestamp
}

medication_administrations [icon: check-circle, color: green] {
  id uuid pk
  medication_id uuid fk
  administered_by uuid fk
  administered_dose string // E.g., "10mg" (can be null if refused)
  status string // E.g., 'ADMINISTERED', 'REFUSED', 'HELD', 'MISSED'
  notes text // The explanation (e.g., "Patient heart rate too low, holding dose")
  scheduled_time timestamp // When it WAS supposed to be given
  administered_at timestamp // When it WAS ACTUALLY given (or attempted)
  is_archived boolean
  archived_at timestamp
}

investigation_orders [icon: file-text, color: green] {
  id uuid pk
  admission_id uuid fk
  ordered_by uuid fk
  order_name string
  type string // e.g., 'Lab', 'Radiology'
  status string // 'Pending', 'Completed'
  order_date timestamp
}

lab_results [icon: thermometer, color: green] {
  id uuid pk
  admission_id uuid fk
  recorded_by uuid fk
  test_name string
  result_value string
  abnormal boolean
  recorded_at timestamp
  is_archived boolean
  archived_at timestamp
}

// ===== CLINICAL DOCUMENTATION & EXAMS =====
// Handles Steps 3 & 4: The rigid checkboxes
clinical_examinations [icon: eye, color: yellow] {
  id uuid pk
  admission_id uuid fk
  examiner_id uuid fk
  general_exams jsonb // Stores built, nutrition, skin, head & neck
  local_exams jsonb // Stores inspection, palpation, percussion, auscultation
  recorded_at timestamp
}

// Handles Step 5 & Daily Updates: The free-text reasoning
clinical_notes [icon: file-text, color: yellow] {
  id uuid pk
  admission_id uuid fk
  author_id uuid fk
  content text
  recorded_at timestamp
  is_archived boolean
  archived_at timestamp
}

// ===== CLINICAL DOCUMENTATION =====
nursing_notes [icon: edit, color: yellow] {
  id uuid pk
  admission_id uuid fk
  author_id uuid fk
  note text
  recorded_at timestamp
  is_archived boolean
  archived_at timestamp
}

follow_ups [icon: file-text, color: yellow] {
  id uuid pk
  admission_id uuid fk
  author_id uuid fk
  objective text
  subjective text
  assessment text
  plan text
  recorded_at timestamp
  is_archived boolean
  archived_at timestamp
}

medical_documents [icon: folder, color: yellow] {
  id uuid pk
  admission_id uuid fk // null for assistant chat resources
  chat_session_id uuid fk // set instead of admission_id for chat resources
  message_id uuid fk
  uploaded_by uuid fk
  document_type string
  original_filename string
  file_path string
  mime_type string
  file_size integer
  embedding_status string
  embedding_error text
  embedding_model string
  chunk_count integer
  embedded_at timestamp
  is_knowledge_base boolean
  storage_type string // local, cloudinary
  cloudinary_url text
  cloudinary_public_id string
  file_content bytea
  uploaded_at timestamp
  is_archived boolean
  archived_at timestamp
}

document_embeddings [icon: cpu, color: yellow] {
  id uuid pk
  document_id uuid fk
  admission_id uuid fk
  chunk_text text
  embedding vector
}

// ===== ARTIFICIAL INTELLIGENCE =====
ai_summaries [icon: zap, color: purple] {
  id uuid pk
  admission_id uuid fk
  requested_by uuid fk
  summary_type string
  overall_summary text
  generated_at timestamp
  is_archived boolean
  archived_at timestamp
}

ai_query_logs [icon: search, color: purple] {
  id uuid pk
  admission_id uuid fk
  asked_by uuid fk
  question text
  ai_response text
  cited_sources jsonb
  created_at timestamp
}

alerts [icon: alert-triangle, color: purple] {
  id uuid pk
  admission_id uuid fk
  severity string
  title string
  triggering_metrics jsonb
  clinical_reasoning text
  status string
  generated_at timestamp
  is_archived boolean
  archived_at timestamp
}

alert_reviews [icon: check-square, color: purple] {
  id uuid pk
  alert_id uuid fk
  reviewer_id uuid fk
  review_notes text
  accepted boolean
  reviewed_at timestamp
  created_at timestamp
}

notifications [icon: bell, color: purple] {
  id uuid pk
  user_id uuid fk
  title string
  message string
  type enum // INFO, ALERT, SUMMON
  status string
  metadata jsonb
  created_at timestamp
  updated_at timestamp
}

ai_chat_sessions [icon: message-circle, color: purple] {
  id uuid pk
  user_id uuid fk
  title string
  mode enum // KNOWLEDGE, PATIENT
  created_at timestamp
  updated_at timestamp
  last_message_at timestamp
}

ai_chat_messages [icon: message-square, color: purple] {
  id uuid pk
  session_id uuid fk
  role enum // USER, ASSISTANT
  content text
  cited_sources jsonb
  retrieval jsonb
  created_at timestamp
}

// ===== SYSTEM MANAGEMENT =====
treatment_approvals [icon: thumbs-up, color: gray] {
  id uuid pk
  admission_id uuid fk
  approved_by uuid fk
  treatment_name string
  clinical_justification text
  approval_status boolean
  requested_at timestamp
  approved_at timestamp
}

// ===== RELATIONSHIPS =====
users.id < login_attempts.user_id
users.id < refresh_tokens.user_id
users.id < audit_logs.user_id
users.id < notifications.user_id
users.id < password_reset_requests.requester_id
users.id < password_reset_requests.resolved_by_id
users.id < ai_chat_sessions.user_id
ai_chat_sessions.id < ai_chat_messages.session_id
ai_chat_sessions.id < medical_documents.chat_session_id
ai_chat_messages.id < medical_documents.message_id

patients.id < admissions.patient_id
patients.id < allergies.patient_id
patients.id < medical_histories.patient_id
beds.id < admissions.bed_id
users.id < admissions.doctor_id

admissions.id < admission_nurses.admission_id
users.id < admission_nurses.nurse_id

admissions.id < diagnoses.admission_id
users.id < diagnoses.diagnosed_by
users.id < diagnoses.original_diagnosed_by
users.id < diagnoses.status_changed_by
diagnoses.id < diagnosis_acknowledgements.diagnosis_id
users.id < diagnosis_acknowledgements.nurse_id
diagnoses.id < diagnosis_concerns.diagnosis_id
users.id < diagnosis_concerns.raised_by
users.id < diagnosis_concerns.responded_by

admissions.id < vital_signs.admission_id
users.id < vital_signs.recorded_by
admissions.id < medications.admission_id
users.id < medications.prescribed_by
medications.id < medication_administrations.medication_id
users.id < medication_administrations.administered_by
admissions.id < investigation_orders.admission_id
users.id < investigation_orders.ordered_by
admissions.id < lab_results.admission_id
users.id < lab_results.recorded_by

admissions.id < nursing_notes.admission_id
users.id < nursing_notes.author_id
admissions.id < follow_ups.admission_id
users.id < follow_ups.author_id
admissions.id < clinical_examinations.admission_id
users.id < clinical_examinations.examiner_id
admissions.id < clinical_notes.admission_id
users.id < clinical_notes.author_id
admissions.id < medical_documents.admission_id
medical_documents.id < document_embeddings.document_id
admissions.id < document_embeddings.admission_id

admissions.id < ai_summaries.admission_id
users.id < ai_summaries.requested_by
admissions.id < ai_query_logs.admission_id
users.id < ai_query_logs.asked_by
admissions.id < alerts.admission_id
alerts.id < alert_reviews.alert_id
users.id < alert_reviews.reviewer_id

admissions.id < treatment_approvals.admission_id
users.id < treatment_approvals.approved_by