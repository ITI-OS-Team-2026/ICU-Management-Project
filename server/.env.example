# ── Server Environment Configuration ──────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── CORS & Client URLs ────────────────────────────────────────────────────────
# CLIENT_URL supports a single URL or comma-separated list of allowed origins
CLIENT_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
SERVER_URL=https://smartcare-icu-backend-production.up.railway.app

# ── Database & Authentication Secrets ─────────────────────────────────────────
# Prefer Neon DIRECT host (without -pooler) for Prisma $transaction support.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&connect_timeout=15

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=12h

# Cookie sameSite option: lax in development, none in production (required for cross-site)
COOKIE_SAME_SITE=lax

# ── Seed Admin Credentials (prisma/seed.js) ──────────────────────────────────
SEED_ADMIN_EMAIL=admin@smartcare.icu
SEED_ADMIN_PASSWORD=SuperSecurePassword2026!
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Admin

SEED_NURSE_EMAIL=nurse@smartcare.icu
SEED_NURSE_PASSWORD=SuperSecurePassword2026!
SEED_NURSE_FIRST_NAME=Test
SEED_NURSE_LAST_NAME=Nurse

SEED_RESIDENT_EMAIL=resident@smartcare.icu
SEED_RESIDENT_PASSWORD=SuperSecurePassword2026!
SEED_RESIDENT_FIRST_NAME=Test
SEED_RESIDENT_LAST_NAME=Resident

SEED_SPECIALIST_EMAIL=specialist@smartcare.icu
SEED_SPECIALIST_PASSWORD=SuperSecurePassword2026!
SEED_SPECIALIST_FIRST_NAME=Test
SEED_SPECIALIST_LAST_NAME=Specialist

# ── Cloudinary Configuration (Knowledge Base Storage) ─────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AI Orchestration & Bedrock Proxy ─────────────────────────────────────────
N8N_SUMMARY_WEBHOOK_URL=
N8N_QUERY_WEBHOOK_URL=
N8N_TIMEOUT_MS=6000

BEDROCK_API_URL=http://apiaccess.iti.net.eg/api/v1/student/chat
BEDROCK_API_KEY=<YOUR_BEDROCK_API_KEY>
BEDROCK_MODEL_ID=us.meta.llama3-3-70b-instruct-v1:0
BEDROCK_TIMEOUT_MS=30000
BEDROCK_MAX_TOKENS=2048

# ── RAG Assistant Configuration ──────────────────────────────────────────────
EMBEDDING_PROVIDER=local
EMBEDDING_API_URL=
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DIMENSIONS=1024

RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=6
RAG_MIN_SCORE=0.02
RAG_RELEVANCE_RATIO=0.35
RAG_MAX_CONTEXT_CHARS=14000
RAG_MAX_DOCUMENT_CHARS=400000
RAG_LIVE_LLM=false

# ── Log Retention Job ─────────────────────────────────────────────────────────
LOG_RETENTION_CRON=15 3 * * *
LOG_RETENTION_BATCH_SIZE=500
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_ARCHIVE_DIR=storage/audit-archive
AI_QUERY_LOG_RETENTION_DAYS=180
LOGIN_ATTEMPT_RETENTION_DAYS=90
PASSWORD_RESET_RETENTION_DAYS=7

# ── Email Configuration ──────────────────────────────────────────────────
# EMAIL_PROVIDER: "brevo" (production HTTP API) or "smtp" (local dev)
EMAIL_PROVIDER=brevo

# Brevo (production transactional email via HTTPS port 443)
BREVO_API_KEY=YOUR_BREVO_API_KEY_HERE
EMAIL_FROM=mohamedahmed010320@gmail.com
EMAIL_FROM_NAME=SmartCare ICU

# SMTP (local development fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ICU SmartCare <noreply@smartcare.local>