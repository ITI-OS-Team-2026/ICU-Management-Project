# Prefer Neon DIRECT host (without -pooler) for Prisma $transaction.
# Example: ...@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&connect_timeout=15

PORT=3000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=12h

# Cloudinary Configuration (Hybrid Storage - Knowledge Base)
# Optional: Used for backing up knowledge base PDFs to Cloudinary.
# If not configured, documents are stored in PostgreSQL BLOB (default).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI orchestration (n8n). Leave empty to use local stub responses (dev/tests).
N8N_SUMMARY_WEBHOOK_URL=
N8N_QUERY_WEBHOOK_URL=
N8N_TIMEOUT_MS=6000

# AI Patient Summary + RAG answer generation — Bedrock via ITI API proxy
BEDROCK_API_URL=http://apiaccess.iti.net.eg/api/v1/student/chat
BEDROCK_API_KEY=<YOUR_BEDROCK_API_KEY>
BEDROCK_MODEL_ID=us.meta.llama3-3-70b-instruct-v1:0
BEDROCK_TIMEOUT_MS=30000
BEDROCK_MAX_TOKENS=2048

# ── RAG assistant (FR-3.1) ───────────────────────────────────────────────────
# Embedding provider for document chunks and questions.
#   local   — deterministic hashed lexical embedding, computed in-process.
#             No API key, no budget, works offline. Matches on wording, not meaning.
#   bedrock — calls EMBEDDING_API_URL (defaults to the /embed sibling of
#             BEDROCK_API_URL). Requires an embedding model your key may invoke;
#             `curl $BEDROCK_API_URL/../me` lists allowed_models.
EMBEDDING_PROVIDER=local
EMBEDDING_API_URL=
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_BATCH_SIZE=16
# MUST equal the vector(N) width of document_embeddings.embedding. Changing this
# requires a migration: ALTER TABLE document_embeddings ALTER COLUMN embedding
# TYPE vector(N); followed by a re-index of every document.
EMBEDDING_DIMENSIONS=1024

RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=6
RAG_MIN_SCORE=0.02
RAG_RELEVANCE_RATIO=0.35
RAG_MAX_CONTEXT_CHARS=14000
RAG_MAX_DOCUMENT_CHARS=400000
# Tests run retrieval-only by default so CI spends no LLM budget. Set to true to
# exercise the real generation path from the test suite.
RAG_LIVE_LLM=false

# ── SMTP (password reset emails) ─────────────────────────────────────────
# Leave SMTP_HOST empty to disable email (temp passwords logged instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ICU SmartCare <noreply@smartcare.local>