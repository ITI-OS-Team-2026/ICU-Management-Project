// Password reset request system — separate from notifications/alerts

enum PasswordResetStatus {
  PENDING
  RESOLVED
}

model PasswordResetRequest {
  id           String              @id @default(uuid())
  requesterId  String
  requester    User                @relation("PasswordResetRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  message      String? // Optional message from user to admin
  status       PasswordResetStatus @default(PENDING)
  adminReply   String? // Admin sends new temp password here
  resolvedById String?
  resolvedBy   User?               @relation("PasswordResetResolutions", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  seenByUser   Boolean             @default(false)
  createdAt    DateTime            @default(now())

  @@index([requesterId])
  @@index([status])
  @@index([status, resolvedAt])
  @@index([createdAt])
}
