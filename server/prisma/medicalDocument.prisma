enum EmbeddingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

// ponytail: medical_documents holds upload metadata plus the RAG indexing lifecycle
// (see src/modules/rag/indexing.service.js). Chunks live in document_embeddings.
model MedicalDocument {
  id               String          @id @default(uuid())
  // Null for assistant chat resources: a clinician can attach a reference file
  // to a Medical Knowledge Assistant chat, which belongs to no admission.
  // Exactly one of admissionId / chatSessionId is set.
  admissionId      String?         @map("admission_id")
  chatSessionId    String?         @map("chat_session_id")
  // The chat message this file was sent with. Null while it is still sitting in
  // the composer — the transcript renders bound files, the composer unbound ones.
  messageId        String?         @map("message_id")
  uploadedBy       String          @map("uploaded_by")
  documentType     String          @map("document_type") @db.VarChar(100)
  originalFilename String          @map("original_filename") @db.VarChar(255)
  filePath         String?         @map("file_path") @db.Text
  mimeType         String?         @map("mime_type") @db.VarChar(150)
  fileSize         Int?            @map("file_size")
  embeddingStatus  EmbeddingStatus @default(PENDING) @map("embedding_status")
  embeddingError   String?         @map("embedding_error") @db.Text
  embeddingModel   String?         @map("embedding_model") @db.VarChar(150)
  chunkCount       Int             @default(0) @map("chunk_count")
  embeddedAt       DateTime?       @map("embedded_at")
  isArchived       Boolean         @default(false) @map("is_archived")
  archivedAt       DateTime?       @map("archived_at")
  createdAt        DateTime        @default(now()) @map("uploaded_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  // Hybrid storage: Knowledge base docs go to Cloudinary, patient docs to BLOB
  isKnowledgeBase  Boolean         @default(false) @map("is_knowledge_base")
  storageType      String          @default("local") @map("storage_type") @db.VarChar(50)
  cloudinaryUrl    String?         @map("cloudinary_url") @db.Text
  cloudinaryPublicId String?       @map("cloudinary_public_id") @db.VarChar(255)
  fileContent      Bytes?          @map("file_content")

  admission   Admission?          @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  chatSession AiChatSession?      @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: the chat cascade already removes the file, and a
  // message delete on its own should never silently destroy an upload.
  message     AiChatMessage?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploader    User                @relation(fields: [uploadedBy], references: [id])
  embeddings  DocumentEmbedding[]

  @@index([admissionId])
  @@index([chatSessionId])
  @@index([messageId])
  @@index([uploadedBy])
  @@index([embeddingStatus])
  @@map("medical_documents")
}

model DocumentEmbedding {
  id             String                      @id @default(uuid())
  documentId     String                      @map("document_id")
  // Mirrors medical_documents.admission_id — null for chat resources, which are
  // scoped by joining medical_documents.chat_session_id instead.
  admissionId    String?                     @map("admission_id")
  chunkIndex     Int                         @default(0) @map("chunk_index")
  chunkText      String                      @map("chunk_text") @db.Text
  charCount      Int                         @default(0) @map("char_count")
  embeddingModel String?                     @map("embedding_model") @db.VarChar(150)
  createdAt      DateTime                    @default(now()) @map("created_at")
  // Written/read exclusively through raw SQL — Prisma cannot map the pgvector type.
  // Dimension is mirrored by config.embeddingDimensions; changing one requires a migration.
  embedding      Unsupported("vector(1024)")

  document  MedicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  admission Admission?      @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([admissionId])
  @@map("document_embeddings")
}
