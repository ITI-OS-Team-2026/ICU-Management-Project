// Artificial Intelligence — summaries and RAG query logs (Wave 7 / API §14).

enum AiSummaryType {
  TWENTY_FOUR_HOUR @map("24_HOUR")
  ON_DEMAND        @map("ON_DEMAND")
}

model AiSummary {
  id             String        @id @default(uuid())
  admissionId    String        @map("admission_id")
  requestedById  String        @map("requested_by")
  summaryType    AiSummaryType @map("summary_type")
  overallSummary String        @map("overall_summary") @db.Text
  generatedAt    DateTime      @default(now()) @map("generated_at")
  isArchived     Boolean       @default(false) @map("is_archived")
  archivedAt     DateTime?     @map("archived_at")

  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  requestedBy User      @relation("AiSummaryRequester", fields: [requestedById], references: [id])

  @@index([admissionId])
  @@index([requestedById])
  @@index([generatedAt])
  @@map("ai_summaries")
}

model AiQueryLog {
  id           String   @id @default(uuid())
  admissionId  String   @map("admission_id")
  askedById    String   @map("asked_by")
  question     String   @db.Text
  aiResponse   String   @map("ai_response") @db.Text
  citedSources Json?    @map("cited_sources")
  createdAt    DateTime @default(now()) @map("created_at")

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  askedBy   User      @relation("AiQueryAsker", fields: [askedById], references: [id])

  @@index([admissionId])
  @@index([askedById])
  @@index([createdAt])
  @@map("ai_query_logs")
}

// ─── Assistant chat sessions ─────────────────────────────────────────────────
// Named, resumable conversations with the Medical Knowledge Assistant. Owned by
// one clinician: only the author lists, resumes, renames or deletes their chats.
// AiQueryLog stays as-is — it is the admission-scoped clinical record of every
// patient-mode question, and is not user-deletable.

enum AiChatMode {
  KNOWLEDGE
  PATIENT
}

enum AiChatRole {
  USER
  ASSISTANT
}

model AiChatSession {
  id            String     @id @default(uuid())
  userId        String     @map("user_id")
  title         String     @db.VarChar(120)
  mode          AiChatMode @default(KNOWLEDGE)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  lastMessageAt DateTime?  @map("last_message_at")

  user     User            @relation("AiChatSessionOwner", fields: [userId], references: [id], onDelete: Cascade)
  messages AiChatMessage[]
  // Files the clinician attached to this chat. Deleting the chat cascades the
  // rows away; the Cloudinary originals are removed by chatResources.service.
  resources MedicalDocument[]

  // The sidebar reads "my chats, newest activity first" on every page load.
  @@index([userId, lastMessageAt(sort: Desc)])
  @@map("ai_chat_sessions")
}

model AiChatMessage {
  id           String     @id @default(uuid())
  sessionId    String     @map("session_id")
  role         AiChatRole
  content      String     @db.Text
  citedSources Json?      @map("cited_sources")
  retrieval    Json?
  createdAt    DateTime   @default(now()) @map("created_at")

  session     AiChatSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Files sent with this message, rendered inline in the transcript.
  attachments MedicalDocument[]

  @@index([sessionId, createdAt])
  @@map("ai_chat_messages")
}
